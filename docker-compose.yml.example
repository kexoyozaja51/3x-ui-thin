services:
  3xui:
    image: ghcr.io/mhsanaei/3x-ui:latest
    cap_add:
      - NET_ADMIN
      - NET_RAW
    volumes:
      - ./db/:/etc/x-ui/
      - ./cert/:/root/cert/
    environment:
      XRAY_VMESS_AEAD_FORCED: "false"
      XUI_ENABLE_FAIL2BAN: "true"
    tty: true
    ports:
      - "127.0.0.1:9745:9745"
    restart: unless-stopped